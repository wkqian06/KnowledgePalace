{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge_palace/protocol/graph_query_port.schema.json",
  "title": "GraphQueryPort",
  "description": "Canonical machine-readable schema for the UI-neutral internal query contract. Semantics: GRAPH_QUERY_PORT.md. Validated by tools/gqp_validator.py (stdlib subset validator).",
  "schema_version": "1.0",
  "operations": [
    "list_hierarchies",
    "list_levels",
    "query_level",
    "query_context",
    "get_content"
  ],
  "error_codes": [
    "stale_index",
    "unknown_hierarchy",
    "unknown_node",
    "unknown_operation",
    "bad_cursor",
    "invalid_request"
  ],
  "$defs": {
    "IndexSnapshot": {
      "type": "object",
      "required": ["snapshot_id", "vault_fingerprint", "built_at"],
      "properties": {
        "snapshot_id": {"type": "string"},
        "vault_fingerprint": {"type": "string"},
        "built_at": {"type": "string"}
      },
      "additionalProperties": false
    },
    "CanonicalRef": {
      "type": "object",
      "required": ["root", "path"],
      "properties": {
        "root": {"enum": ["vault", "state", "source", "workspace", "framework"]},
        "path": {"type": "string", "pattern": "^[^/\\\\]"},
        "anchor": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "NodeView": {
      "type": "object",
      "required": ["id", "kind", "label"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"type": "string"},
        "label": {"type": "string"},
        "canonical_ref": {"$ref": "#/$defs/CanonicalRef"},
        "attrs": {"type": "object"}
      },
      "additionalProperties": false
    },
    "EdgeView": {
      "type": "object",
      "required": ["id", "kind", "from", "to"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"type": "string"},
        "from": {"type": "string"},
        "to": {"type": "string"},
        "attrs": {"type": "object"}
      },
      "additionalProperties": false
    },
    "HierarchyLevel": {
      "type": "object",
      "required": ["level", "label", "node_kinds"],
      "properties": {
        "level": {"type": "integer", "minimum": 0},
        "label": {"type": "string"},
        "node_kinds": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "HierarchySpec": {
      "type": "object",
      "required": ["id", "label", "levels"],
      "properties": {
        "id": {"type": "string"},
        "label": {"type": "string"},
        "levels": {"type": "array", "items": {"$ref": "#/$defs/HierarchyLevel"}}
      },
      "additionalProperties": false
    },
    "NodePage": {
      "type": "object",
      "required": ["total", "returned", "truncated", "next_cursor", "items"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "returned": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"},
        "next_cursor": {"type": ["string", "null"]},
        "items": {"type": "array", "items": {"$ref": "#/$defs/NodeView"}}
      },
      "additionalProperties": false
    },
    "EdgePage": {
      "type": "object",
      "required": ["total", "returned", "truncated", "next_cursor", "items"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "returned": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"},
        "next_cursor": {"type": ["string", "null"]},
        "items": {"type": "array", "items": {"$ref": "#/$defs/EdgeView"}}
      },
      "additionalProperties": false
    },
    "SiblingGroup": {
      "type": "object",
      "required": ["parent_id", "page"],
      "properties": {
        "parent_id": {"type": "string"},
        "page": {"$ref": "#/$defs/NodePage"}
      },
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "stale_index",
            "unknown_hierarchy",
            "unknown_node",
            "unknown_operation",
            "bad_cursor",
            "invalid_request"
          ]
        },
        "message": {"type": "string"},
        "evidence": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "ErrorResponse": {
      "type": "object",
      "required": ["schema_version", "error"],
      "properties": {
        "schema_version": {"type": "string"},
        "snapshot": {"$ref": "#/$defs/IndexSnapshot"},
        "error": {"$ref": "#/$defs/Error"}
      },
      "additionalProperties": false
    },
    "ListHierarchiesResponse": {
      "type": "object",
      "required": ["schema_version", "snapshot", "hierarchies"],
      "properties": {
        "schema_version": {"type": "string"},
        "snapshot": {"$ref": "#/$defs/IndexSnapshot"},
        "hierarchies": {"type": "array", "items": {"$ref": "#/$defs/HierarchySpec"}}
      },
      "additionalProperties": false
    },
    "ListLevelsResponse": {
      "type": "object",
      "required": ["schema_version", "snapshot", "hierarchy_id", "levels"],
      "properties": {
        "schema_version": {"type": "string"},
        "snapshot": {"$ref": "#/$defs/IndexSnapshot"},
        "hierarchy_id": {"type": "string"},
        "levels": {"type": "array", "items": {"$ref": "#/$defs/HierarchyLevel"}}
      },
      "additionalProperties": false
    },
    "QueryLevelResponse": {
      "type": "object",
      "required": ["schema_version", "snapshot", "hierarchy_id", "level", "page"],
      "properties": {
        "schema_version": {"type": "string"},
        "snapshot": {"$ref": "#/$defs/IndexSnapshot"},
        "hierarchy_id": {"type": "string"},
        "level": {"type": "integer", "minimum": 0},
        "page": {"$ref": "#/$defs/NodePage"}
      },
      "additionalProperties": false
    },
    "QueryContextResponse": {
      "type": "object",
      "required": [
        "schema_version",
        "snapshot",
        "node",
        "parents",
        "entry_parent",
        "siblings",
        "sibling_groups",
        "children",
        "edges"
      ],
      "properties": {
        "schema_version": {"type": "string"},
        "snapshot": {"$ref": "#/$defs/IndexSnapshot"},
        "node": {"$ref": "#/$defs/NodeView"},
        "parents": {"type": "array", "items": {"$ref": "#/$defs/NodeView"}},
        "entry_parent": {"type": ["string", "null"]},
        "siblings": {"oneOf": [{"$ref": "#/$defs/NodePage"}, {"type": "null"}]},
        "sibling_groups": {
          "oneOf": [
            {"type": "array", "items": {"$ref": "#/$defs/SiblingGroup"}},
            {"type": "null"}
          ]
        },
        "children": {"$ref": "#/$defs/NodePage"},
        "edges": {"$ref": "#/$defs/EdgePage"}
      },
      "additionalProperties": false
    },
    "GetContentResponse": {
      "type": "object",
      "required": ["schema_version", "snapshot", "node_id", "canonical_ref", "media_type", "content", "truncated"],
      "properties": {
        "schema_version": {"type": "string"},
        "snapshot": {"$ref": "#/$defs/IndexSnapshot"},
        "node_id": {"type": "string"},
        "canonical_ref": {"$ref": "#/$defs/CanonicalRef"},
        "media_type": {"type": "string"},
        "content": {"type": "string"},
        "truncated": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "responses": {
    "list_hierarchies": "#/$defs/ListHierarchiesResponse",
    "list_levels": "#/$defs/ListLevelsResponse",
    "query_level": "#/$defs/QueryLevelResponse",
    "query_context": "#/$defs/QueryContextResponse",
    "get_content": "#/$defs/GetContentResponse"
  },
  "x-invariants": [
    "Every response carries schema_version; every success response carries snapshot.",
    "GraphPage: returned == len(items); returned <= total; truncated <=> next_cursor is non-null; a truncated page has returned < total; following next_cursor to exhaustion yields exactly total items.",
    "CanonicalRef.path is relative and forward-slash: never absolute, no '..', no backslash, no drive letter, no URL scheme.",
    "Node kinds are an open set: unknown kinds must validate.",
    "query_context: entry_parent given => siblings page under that parent, sibling_groups null; multi-parent without entry_parent => sibling_groups per parent, siblings null.",
    "brief nodes: attrs.role == 'view' and attrs.evidence_capable == false; no evidence-bearing edge originates from a brief node.",
    "A success response served from a stale index violates the contract; the conforming behavior is an error with code 'stale_index'.",
    "The five operations are the entire surface; no write operation exists."
  ]
}
